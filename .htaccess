# ════════ SECURITY HEADERS ════════
<IfModule mod_headers.c>
  # HSTS (force HTTPS for 1 year)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Prevent MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking protection
  Header always set X-Frame-Options "DENY"

  # XSS protection (browser-level)
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # CSP — real source allowlist. 'unsafe-inline' is required for script-src/
  # style-src because the site uses inline <script> blocks and onclick=
  # handlers throughout (no nonce/hash infrastructure); this still blocks
  # loading executable content from any non-whitelisted external origin.
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://*.clarity.ms https://c.bing.com https://checkout.razorpay.com https://cdn.razorpay.com https://www.googletagmanager.com https://snapwidget.com https://news.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.clarity.ms https://c.bing.com https://cdn.razorpay.com https://snapwidget.com https://*.cdninstagram.com https://scontent.cdninstagram.com https://www.google.com https://www.google.co.in https://www.googletagmanager.com; connect-src 'self' https://*.clarity.ms https://c.bing.com https://api.razorpay.com https://lumberjack.razorpay.com https://www.googletagmanager.com https://*.google-analytics.com https://analytics.google.com https://www.google.com; frame-src https://www.google.com https://api.razorpay.com https://checkout.razorpay.com https://snapwidget.com; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"

  # Permissions-Policy — the site doesn't use any of these browser features
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), interest-cohort=()"
</IfModule>

# ════════ CACHING RULES ════════
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"

  # HTML (5 minutes — kept short so a deploy without a manual CDN purge
  # only stays stale briefly instead of up to a day; JS/CSS/images are safe
  # to cache long because they're version-tagged or content-addressed)
  ExpiresByType text/html "access plus 5 minutes"

  # CSS/JS (30 days, versioned in production)
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType application/x-javascript "access plus 30 days"

  # Images (90 days)
  ExpiresByType image/jpeg "access plus 90 days"
  ExpiresByType image/gif "access plus 90 days"
  ExpiresByType image/png "access plus 90 days"
  ExpiresByType image/webp "access plus 90 days"
  ExpiresByType image/svg+xml "access plus 90 days"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts (1 year)
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # Video (90 days)
  ExpiresByType video/mp4 "access plus 90 days"
  ExpiresByType video/webm "access plus 90 days"
</IfModule>

<IfModule mod_headers.c>
  # Explicit cache headers per type
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
    Header set Cache-Control "public, max-age=7776000, immutable"
  </FilesMatch>

  <FilesMatch "\.(mp4|webm)$">
    Header set Cache-Control "public, max-age=7776000, immutable"
  </FilesMatch>

  <FilesMatch "\.(woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(md)$">
    Header set Cache-Control "public, max-age=1800, must-revalidate"
  </FilesMatch>
</IfModule>

# ════════ MIME TYPES ════════
<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType image/webp .webp
  AddType text/markdown .md
</IfModule>

# ════════ LITESPEED CACHE (if available) ════════
# LiteSpeed Web Server Cache directives
<IfModule mod_lscache.c>
  CacheLookup public on

  # Cache HTML pages for 5 minutes (see mod_headers block above for why)
  <FilesMatch "\.(html)$">
    CacheEnable public
    CacheMaxAge 300
  </FilesMatch>

  # Cache CSS/JS for 30 days
  <FilesMatch "\.(css|js)$">
    CacheEnable public
    CacheMaxAge 2592000
  </FilesMatch>

  # Cache images for 90 days
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    CacheEnable public
    CacheMaxAge 7776000
  </FilesMatch>

  # Cache video for 90 days
  <FilesMatch "\.(mp4|webm)$">
    CacheEnable public
    CacheMaxAge 7776000
  </FilesMatch>

  # Cache fonts for 1 year
  <FilesMatch "\.(woff|woff2|ttf|otf)$">
    CacheEnable public
    CacheMaxAge 31536000
  </FilesMatch>

  # Cache markdown files for 30 minutes
  <FilesMatch "\.(md)$">
    CacheEnable public
    CacheMaxAge 1800
  </FilesMatch>
</IfModule>

<IfModule mod_dir.c>
  DirectoryIndex index.html index.php
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Block direct web access to internal API library files (config/credentials,
  # ezee/razorpay/mock helpers) — these are only ever `require`d by api/*.php,
  # never requested directly, but had no server-side deny.
  RewriteRule ^api/lib/ - [F,L]

  # Force HTTPS + www in a single hop (http apex, http www, and https apex
  # all used to bounce through an intermediate hop before landing here)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^mosaichostels\.com$ [NC]
  RewriteRule ^(.*)$ https://www.mosaichostels.com/$1 [R=301,L]

  # Canonicalize direct .html requests to their clean extensionless URL —
  # without these, the same content was reachable at two different URLs
  # (e.g. /about.html AND /about both returning 200), a duplicate-content risk.
  RewriteRule ^index\.html$ / [R=301,L]
  # Only for a real client request: DirectoryIndex re-requests /blog/index.html
  # internally when serving /blog/, and an unconditioned rule would loop.
  RewriteCond %{THE_REQUEST} \s/blog/index\.html[\s?]
  RewriteRule ^blog/index\.html$ /blog/ [R=301,L]
  RewriteRule ^about\.html$ /about [R=301,L]
  RewriteRule ^contact\.html$ /contact [R=301,L]
  RewriteRule ^book-now\.html$ /book-now [R=301,L]
  RewriteRule ^gallery\.html$ /gallery [R=301,L]
  RewriteRule ^privacy\.html$ /privacy [R=301,L]
  RewriteRule ^blog\.html$ /blog/ [R=301,L]

  # Legacy WordPress blog URL — reclaim ranking equity (was ranking
  # position 7.9-10.5, 859 impressions/90d in GSC before the migration)
  RewriteRule ^varanasi-solo-female-travelers-safety-travel-guide/?$ /blog/varanasi-solo-female-travelers-safety-travel-guide/ [R=301,L]

  # Consolidated Assi Ghat posts — merged into assi-ghat-varanasi-complete-guide
  # (targets end in / since these are real directories — omitting the slash
  # here means mod_dir issues a second 301 to append it, a 2-hop redirect)
  RewriteRule ^blog/why-assi-ghat-perfect-base-varanasi-stay/?$ /blog/assi-ghat-varanasi-complete-guide/ [R=301,L]
  RewriteRule ^blog/hostel-near-assi-ghat-varanasi/?$ /blog/assi-ghat-varanasi-complete-guide/ [R=301,L]
  RewriteRule ^blog/backpackers-guide-assi-ghat-varanasi/?$ /blog/assi-ghat-varanasi-complete-guide/ [R=301,L]

  # Cannibalization redirect: top-7-experiences → things-to-do (audit finding 2026-09-08)
  # Both target same intent. Source: 647w, 0 inbound. Target: 1146w, 12 inbound.
  RewriteRule ^blog/top-7-experiences-varanasi-traveler/?$ /blog/things-to-do-varanasi-local-guide/ [R=301,L]

  # Legacy URLs still drawing impressions while returning 404. GSC URL
  # Inspection on 2026-09-07 reported all four as "Not found (404)" with live
  # impressions over the prior 90 days: /contact-us/ 14, /experiences/ 3,
  # /llms-txt/ 3, /about-us/ 2. A 404 discards that equity; a 301 reclaims it.
  # /experiences/ targets the final destination directly (was a 2-hop redirect
  # through top-7-experiences-varanasi-traveler, itself redirected below).
  RewriteRule ^about-us/?$ /about [R=301,L]
  RewriteRule ^contact-us/?$ /contact [R=301,L]
  RewriteRule ^experiences/?$ /blog/things-to-do-varanasi-local-guide/ [R=301,L]
  RewriteRule ^llms-txt/?$ /llms.txt [R=301,L]

  # 6 more legacy WordPress-era URLs found still 404ing in GSC's full
  # indexing drill-down (weekly-seo run, 2026-09-28) — same pattern as the
  # four above, pre-migration slugs with no /blog/ prefix or a since-renamed
  # slug, each with an obvious live-content target. The two "experiences"
  # posts had a temporary Google removal (submitted 2026-04-27) that has
  # since expired, so they're now crawlable-but-broken rather than
  # suppressed — reclaiming them now matters more than it did in April.
  RewriteRule ^hostel-near-assi-ghat-varanasi/?$ /blog/assi-ghat-varanasi-complete-guide/ [R=301,L]
  RewriteRule ^10-reasons-why-backpackers-love-staying-at-mosaic-hostels-in-varanasi/?$ /blog/best-hostels-in-varanasi/ [R=301,L]
  RewriteRule ^best-time-to-visit-varanasi-month-by-month-guide/?$ /blog/best-time-to-visit-varanasi-month-by-month/ [R=301,L]
  RewriteRule ^top-7-experiences-you-cant-miss-in-varanasi-as-a-traveler/?$ /blog/things-to-do-varanasi-local-guide/ [R=301,L]
  RewriteRule ^7-must-do-experiences-near-mosaic-hostels-in-varanasi/?$ /blog/things-to-do-varanasi-local-guide/ [R=301,L]
  RewriteRule ^varanasi-for-solo-female-travelers-a-complete-safety-travel-guide/?$ /blog/varanasi-solo-female-travelers-safety-travel-guide/ [R=301,L]

  # Malformed URLs Google AI Overviews invented when citing this site (GSC's
  # new "Performance on Search generative AI features" report, 2026-09-28) —
  # typos and a wrong slug that would 404 if a real user clicked through.
  RewriteRule ^blog/assi-ghat-vs-dashashwamedh-where-should-you-stay/?$ /blog/assi-ghat-vs-dashashwamedh-where-to-stay/ [R=301,L]
  RewriteRule ^blog/assi-ghate-vs-dashashwamedh-where-to-stay/?$ /blog/assi-ghat-vs-dashashwamedh-where-to-stay/ [R=301,L]
  RewriteRule ^blog/is-vaganas-safe-general-guide/?$ /blog/is-varanasi-safe-general-guide/ [R=301,L]

  # Normalize trailing slash on core pages to the non-slash canonical form
  # (these are .html files, not directories, unlike /blog/<slug> — both
  # /about and /about/ were silently serving 200 with no redirect, a
  # duplicate-URL issue).
  RewriteRule ^gallery/$ /gallery [R=301,L]
  RewriteRule ^about/$ /about [R=301,L]
  RewriteRule ^contact/$ /contact [R=301,L]
  RewriteRule ^book-now/$ /book-now [R=301,L]
  RewriteRule ^privacy/$ /privacy [R=301,L]

  # Rewrite clean URLs to .html files
  # NOTE: RewriteCond only binds to the single next RewriteRule, so the
  # "real file/directory" and "/blogs/" guards must be repeated before
  # EVERY rule below, not stated once at the top of the block.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/blogs/ [NC]
  RewriteRule ^gallery/?$ gallery.html [QSA,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/blogs/ [NC]
  RewriteRule ^blog/?$ blog.html [QSA,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/blogs/ [NC]
  RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog/post.html [QSA,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/blogs/ [NC]
  RewriteRule ^about/?$ about.html [QSA,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/blogs/ [NC]
  RewriteRule ^contact/?$ contact.html [QSA,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/blogs/ [NC]
  RewriteRule ^book-now/?$ book-now.html [QSA,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/blogs/ [NC]
  RewriteRule ^privacy/?$ privacy.html [QSA,L]
