# ════════ SECURITY HEADERS ════════
<IfModule mod_headers.c>
  # HSTS (force HTTPS for 1 year)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Prevent MIME sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking protection
  Header always set X-Frame-Options "DENY"

  # XSS protection (browser-level)
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # CSP (upgrade insecure requests to HTTPS)
  Header set Content-Security-Policy "upgrade-insecure-requests"
</IfModule>

# ════════ CACHING RULES ════════
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"

  # HTML (1 day)
  ExpiresByType text/html "access plus 1 day"

  # CSS/JS (30 days, versioned in production)
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType application/x-javascript "access plus 30 days"

  # Images (90 days)
  ExpiresByType image/jpeg "access plus 90 days"
  ExpiresByType image/gif "access plus 90 days"
  ExpiresByType image/png "access plus 90 days"
  ExpiresByType image/webp "access plus 90 days"
  ExpiresByType image/svg+xml "access plus 90 days"
  ExpiresByType image/x-icon "access plus 1 year"

  # Fonts (1 year)
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # Video (90 days)
  ExpiresByType video/mp4 "access plus 90 days"
  ExpiresByType video/webm "access plus 90 days"
</IfModule>

<IfModule mod_headers.c>
  # Explicit cache headers per type
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>

  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
    Header set Cache-Control "public, max-age=7776000, immutable"
  </FilesMatch>

  <FilesMatch "\.(mp4|webm)$">
    Header set Cache-Control "public, max-age=7776000, immutable"
  </FilesMatch>

  <FilesMatch "\.(woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(md)$">
    Header set Cache-Control "public, max-age=1800, must-revalidate"
  </FilesMatch>
</IfModule>

# ════════ MIME TYPES ════════
<IfModule mod_mime.c>
  AddType video/webm .webm
  AddType video/mp4 .mp4
  AddType image/webp .webp
  AddType text/markdown .md
</IfModule>

# ════════ LITESPEED CACHE (if available) ════════
# LiteSpeed Web Server Cache directives
<IfModule mod_lscache.c>
  CacheLookup public on

  # Cache HTML pages for 1 day
  <FilesMatch "\.(html)$">
    CacheEnable public
    CacheMaxAge 86400
  </FilesMatch>

  # Cache CSS/JS for 30 days
  <FilesMatch "\.(css|js)$">
    CacheEnable public
    CacheMaxAge 2592000
  </FilesMatch>

  # Cache images for 90 days
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    CacheEnable public
    CacheMaxAge 7776000
  </FilesMatch>

  # Cache video for 90 days
  <FilesMatch "\.(mp4|webm)$">
    CacheEnable public
    CacheMaxAge 7776000
  </FilesMatch>

  # Cache fonts for 1 year
  <FilesMatch "\.(woff|woff2|ttf|otf)$">
    CacheEnable public
    CacheMaxAge 31536000
  </FilesMatch>

  # Cache markdown files for 30 minutes
  <FilesMatch "\.(md)$">
    CacheEnable public
    CacheMaxAge 1800
  </FilesMatch>
</IfModule>

<IfModule mod_dir.c>
  DirectoryIndex index.html index.php
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect non-www to www
  RewriteCond %{HTTP_HOST} ^mosaichostels\.com$ [NC]
  RewriteRule ^(.*)$ https://www.mosaichostels.com/$1 [L,R=301]

  # Legacy WordPress blog URL — reclaim ranking equity (was ranking
  # position 7.9-10.5, 859 impressions/90d in GSC before the migration)
  RewriteRule ^varanasi-solo-female-travelers-safety-travel-guide/?$ /blog/varanasi-solo-female-travelers-safety-travel-guide [R=301,L]

  # Rewrite clean URLs to .html files
  # NOTE: RewriteCond only binds to the single next RewriteRule, so the
  # "real file/directory" and "/blogs/" guards must be repeated before
  # EVERY rule below, not stated once at the top of the block.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/blogs/ [NC]
  RewriteRule ^gallery/?$ gallery.html [QSA,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/blogs/ [NC]
  RewriteRule ^blog/?$ blog.html [QSA,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/blogs/ [NC]
  RewriteRule ^blog/([a-zA-Z0-9-]+)/?$ blog/post.html [QSA,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/blogs/ [NC]
  RewriteRule ^about/?$ about.html [QSA,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/blogs/ [NC]
  RewriteRule ^contact/?$ contact.html [QSA,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/blogs/ [NC]
  RewriteRule ^book-now/?$ book-now.html [QSA,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/blogs/ [NC]
  RewriteRule ^privacy/?$ privacy.html [QSA,L]
