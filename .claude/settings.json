{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/naveen/.agents/hooks/project_sync.py pre",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": [
    "mosaic-bing",
    "mosaic-clarity",
    "mosaic-ga4",
    "mosaic-gbp",
    "mosaic-gsc",
    "razorpay"
  ],
